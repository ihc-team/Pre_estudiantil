# Copia este archivo como .env y ajusta los valores.
# .env no se sube al repositorio.

# ===== Flutter =====
# Web local: backend en tu computador.
# En Docker de producción se usa /api automáticamente.
API_BASE_URL=http://localhost:3000
APP_NAME="UniBudget"

# Emulador Android: http://10.0.2.2:3000
# iPhone físico: http://IP_DE_TU_MAC:3000

# ===== Backend / PostgreSQL =====
DB_HOST=localhost
DB_PORT=55432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
SERVER_PORT=3000

# ===== Despliegue HTTPS =====
DOMAIN=presupuesto.sebaces.fyi
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
LETSENCRYPT_DIR=/etc/letsencrypt
